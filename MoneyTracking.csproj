<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>


  <ItemGroup>
    <!-- Exclude test project sources so the main Exe doesn't glob them -->
    <Compile Remove="MoneyTracking.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy mock data to output so dotnet run finds it from any working directory -->
    <Content Include="moneyitems.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
