@startuml MoneyTracking_Sequence_SortFilterSearch
' ============================================================
' Money Tracking - UML Sequence Diagram: Sort / Filter / Search
' Money Tracking Project - C# Console Application
' ============================================================

skinparam backgroundColor #FEFEFE
skinparam defaultFontName "Segoe UI"
skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 25
skinparam BoxPadding 20

box "Console UI" #E3F2FD
    actor "User" as User
    participant "Program.cs" as P
end box

box "Services" #E8F5E9
    participant "ItemCollection" as IC
end box

box "Domain" #FFF3E0
    participant "SortField" as SF
    participant "ItemType" as IT
end box

' ============================================================
' SORT WORKFLOW
' ============================================================

== SORT Items ==
User -> P : Choose menu "4" (Sort)
activate P
P --> User : "Sort by: 1=Month 2=Amount 3=Title"
User -> P : Choose "2" (Amount)
P -> SF : PromptSortField()
note right: returns SortField.Amount
P --> User : "Direction: 1=Ascending 2=Descending"
User -> P : Choose "2" (Descending)
P -> P : PromptAscending()
note right: returns false

P -> IC : GetSorted(SortField.Amount, false)
activate IC
IC -> IC : _items.OrderByDescending(i => i.Amount)
IC --> P : IReadOnlyList<MoneyItem> (sorted)
deactivate IC

P -> P : PrintList(sortedItems)
note right
  Shows:
  - Header + colored rows
  - Income/Expense totals
  - Net balance for this view
end note
P --> User : Display sorted list + summary
deactivate P

' ============================================================
' FILTER WORKFLOW
' ============================================================

== FILTER Items ==
User -> P : Choose menu "5" (Filter)
activate P
P --> User : "Show: 1=Income 2=Expense"
User -> P : Choose "2" (Expense)
P -> IT : PromptItemType()
note right: returns ItemType.Expense
P --> User : "Month (1-12, Enter=all): "
alt User enters month
    User -> P : Enter "3" (March)
    P -> P : PromptOptionalMonth()\nreturns 3
    P -> IC : GetFiltered(ItemType.Expense, 3)
    activate IC
    IC -> IC : Where(i => i.Type == Expense && i.Month == 3)
else User presses Enter (skip month)
    User -> P : <Enter>
    P -> P : PromptOptionalMonth()\nreturns null
    P -> IC : GetFiltered(ItemType.Expense, null)
    activate IC
    IC -> IC : Where(i => i.Type == Expense)
end
IC --> P : IReadOnlyList<MoneyItem> (filtered)
deactivate IC

P -> P : PrintList(filteredItems)
note right: Totals & balance reflect filtered subset
P --> User : Display filtered list + summary
deactivate P

' ============================================================
' SEARCH WORKFLOW
' ============================================================

== SEARCH by Keyword ==
User -> P : Choose menu "6" (Search)
activate P
P --> User : "Search title: "
User -> P : Enter keyword "salary"
P -> P : PromptNonEmpty()

P -> IC : GetByKeyword("salary")
activate IC
note right of IC
  StringComparison.OrdinalIgnoreCase
  i.Title.Contains(keyword)
end note
IC -> IC : Where(title.Contains("salary", OrdinalIgnoreCase))
IC --> P : IReadOnlyList<MoneyItem> (matches)
deactivate IC

alt any matches
    P -> P : PrintList(matches)
    P --> User : Display matching items + totals
else no matches
    P --> User : "No items."
end
deactivate P

@enduml
