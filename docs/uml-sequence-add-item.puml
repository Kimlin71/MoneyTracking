@startuml MoneyTracking_Sequence_AddItem
' ============================================================
' Money Tracking - UML Sequence Diagram: Add Item Workflow
' Money Tracking Project - C# Console Application
' ============================================================

skinparam backgroundColor #FEFEFE
skinparam defaultFontName "Segoe UI"
skinparam sequenceArrowThickness 2
skinparam roundcorner 10
skinparam sequenceMessageAlign center
skinparam ParticipantPadding 30
skinparam BoxPadding 20

box "Console UI (Presentation Layer)" #E3F2FD
    participant "User" as User
    participant "Program.cs" as Program
end box

box "Services Layer" #E8F5E9
    participant "ItemCollection" as Collection
end box

box "Domain Layer" #FFF3E0
    participant "MoneyItem" as Item
    participant "ItemType" as Type
end box

box "Persistence" #FCE4EC
    participant "JsonPersistence" as Persistence
    database "moneyitems.json" as DB
end box

' ============================================================
' AUTO-LOAD AT STARTUP
' ============================================================

activate Program
== Application Startup ==
Program -> Persistence : Load(DataFile)
    activate Persistence
    Persistence -> DB : Read JSON
    alt file exists & valid
        DB --> Persistence : List<MoneyItem>
    else file missing or malformed
        DB --> Persistence : (error / not found)
        Persistence --> Program : [] (empty list)
    end
    Persistence --> Program : IReadOnlyList<MoneyItem>
    deactivate Persistence
loop for each loaded item
    Program -> Collection : Add(item)
end
Program --> User : Show menu (with balance header)
deactivate Program

' ============================================================
' ADD ITEM WORKFLOW
' ============================================================

== User Chooses: Add New Item ==
User -> Program : Choose menu option "2"
activate Program
Program --> User : "Add: 1=Income 2=Expense"
User -> Program : Choose "1" (Income) or "2" (Expense)
Program -> Type : (prompt for ItemType)

Program --> User : Prompt: "Title: "
User -> Program : Enter title
Program --> User : Prompt: "Amount: "
User -> Program : Enter amount
Program -> Program : PromptDecimal()\n(culture-invariant parsing)
Program --> User : Prompt: "Month (1-12): "
User -> Program : Enter month
Program -> Program : PromptMonth()\n(validate 1-12)

' Create MoneyItem
create Item
Program -> Item : new MoneyItem(\n  Guid.NewGuid(),\n  title, amount, month, type)
activate Item
Item --> Program : MoneyItem instance
deactivate Item

' Add to collection
Program -> Collection : Add(item)
activate Collection
Collection -> Collection : _items.Add(item)
Collection --> Program : void
deactivate Collection

Program --> User : "Added. (Choose 'Save and Quit' to persist)"
deactivate Program

' ============================================================
' SAVE AND QUIT
' ============================================================

== User Chooses: Save and Quit ==
User -> Program : Choose menu option "0"
activate Program
Program -> Collection : GetAll()
activate Collection
Collection --> Program : IReadOnlyList<MoneyItem>
deactivate Collection

Program -> Persistence : Save(items, DataFile)
    activate Persistence
    note right of Persistence
        Atomic write strategy:
        1. Write to .tmp file
        2. File.Move with overwrite
        3. Set permissions 600 (Unix)
        4. Delete .tmp on error
    end note
    Persistence -> DB : Write JSON atomically
    Persistence --> Program : void (or IOException)
    deactivate Persistence

alt save succeeded
    Program --> User : "Saved. Goodbye!"
else save failed (IOException)
    Program --> User : "Save failed: ..."
end

deactivate Program

@enduml
